// Tremor (integer-only Ogg Vorbis decoder, libvorbisidec 1.2.1) + libogg 1.3.2 framing,
// as one static library for SDL_mixer's Ogg music and sounds. Sources taken from SDL_mixer 2.0.4's external folder.
TARGET        tremor.lib
TARGETTYPE    lib
ALWAYS_BUILD_AS_ARM

SYSTEMINCLUDE \epoc32\include \epoc32\include\stdapis
SYSTEMINCLUDE ..\include
USERINCLUDE   ..

SOURCEPATH    ..
SOURCE block.c codebook.c floor0.c floor1.c info.c mapping0.c mdct.c
SOURCE registry.c res012.c sharedbook.c synthesis.c vorbisfile.c window.c

SOURCEPATH    ..\ogg
SOURCE bitwise.c framing.c
