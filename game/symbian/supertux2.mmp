SOURCE        language_menu.cpp main_menu.cpp menu_storage.cpp options_menu.cpp profile_menu.cpp worldmap_menu.cpp

SOURCEPATH    ..\src\trigger
SOURCE        climbable.cpp door.cpp scripttrigger.cpp secretarea_trigger.cpp sequence_trigger.cpp switch.cpp
SOURCE        trigger_base.cpp

