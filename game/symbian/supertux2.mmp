SOURCE        file_system.cpp log.cpp reader.cpp string_util.cpp utf8_iterator.cpp

SOURCEPATH    ..\src\video
SOURCE        color.cpp drawing_context.cpp font.cpp renderer.cpp surface.cpp texture_manager.cpp
SOURCE        video_systems.cpp

SOURCEPATH    ..\src\video\sdl
SOURCE        sdl_lightmap.cpp sdl_renderer.cpp sdl_texture.cpp

SOURCEPATH    ..\src\worldmap
SOURCE        special_tile.cpp sprite_change.cpp teleporter.cpp tux.cpp worldmap.cpp

SOURCEPATH    renamed
SOURCE        scripting_camera.cpp scripting_candle.cpp scripting_floating_image.cpp scripting_level.cpp
SOURCE        scripting_level_time.cpp scripting_platform.cpp scripting_thunderstorm.cpp scripting_tilemap.cpp
SOURCE        scripting_wind.cpp tinygettext_log.cpp worldmap_direction.cpp worldmap_level.cpp
SOURCE        worldmap_spawn_point.cpp

SOURCEPATH    .
SOURCE        symbian_main.cpp sdl_missing.c

STATICLIBRARY sdlmain.lib sdl_mixer_ogg.lib tremor.lib physfs.lib sdl_image.lib lpng.lib
LIBRARY       st2sdl.lib st2sdlexe.lib libstdcpp.lib libc.lib libm.lib libpthread.lib libz.lib
LIBRARY       euser.lib estlib.lib

SOURCEPATH    .
START RESOURCE supertux2.rss
HEADER
TARGETPATH    \resource\apps
LANG          SC
END

START RESOURCE supertux2_reg.rss
TARGETPATH    \private\10003a3f\apps
END

CAPABILITY    LocalServices
