SOURCE        smartball.cpp snail.cpp snowball.cpp snowman.cpp spidermite.cpp spiky.cpp
SOURCE        sspiky.cpp stalactite.cpp stumpy.cpp toad.cpp totem.cpp treewillowisp.cpp
SOURCE        walking_badguy.cpp walkingleaf.cpp willowisp.cpp yeti.cpp yeti_stalactite.cpp zeekling.cpp

