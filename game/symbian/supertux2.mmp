SOURCEPATH    ..\src\lisp
SOURCE        lexer.cpp lisp.cpp list_iterator.cpp parser.cpp writer.cpp

SOURCEPATH    ..\src\math
SOURCE        aatriangle.cpp random_generator.cpp rectf.cpp size.cpp sizef.cpp vector.cpp

SOURCEPATH    ..\src\object
SOURCE        ambient_sound.cpp anchor_point.cpp background.cpp bicycle_platform.cpp block.cpp bonus_block.cpp
SOURCE        bouncy_coin.cpp brick.cpp broken_brick.cpp bullet.cpp camera.cpp candle.cpp
SOURCE        cloud_particle_system.cpp coin.cpp comet_particle_system.cpp decal.cpp display_effect.cpp electrifier.cpp
SOURCE        endsequence.cpp endsequence_fireworks.cpp endsequence_walkleft.cpp endsequence_walkright.cpp explosion.cpp falling_coin.cpp
SOURCE        firefly.cpp fireworks.cpp floating_image.cpp floating_text.cpp flower.cpp ghost_particle_system.cpp
SOURCE        gradient.cpp growup.cpp hurting_platform.cpp icecrusher.cpp infoblock.cpp invisible_block.cpp
SOURCE        invisible_wall.cpp ispy.cpp lantern.cpp level_time.cpp light.cpp magicblock.cpp
SOURCE        moving_sprite.cpp oneup.cpp particles.cpp particlesystem.cpp particlesystem_interactive.cpp path.cpp
SOURCE        path_walker.cpp platform.cpp player.cpp pneumatic_platform.cpp powerup.cpp pulsing_light.cpp
SOURCE        pushbutton.cpp rain_particle_system.cpp rainsplash.cpp rock.cpp rusty_trampoline.cpp scripted_object.cpp
SOURCE        skull_tile.cpp smoke_cloud.cpp snow_particle_system.cpp specialriser.cpp spotlight.cpp sprite_particle.cpp
