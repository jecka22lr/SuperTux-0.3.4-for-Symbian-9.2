SOURCE        wrapper.cpp

SOURCEPATH    ..\src\sprite
SOURCE        sprite.cpp sprite_data.cpp sprite_manager.cpp

SOURCEPATH    ..\src\supertux
SOURCE        collision.cpp colorscheme.cpp console.cpp direction.cpp fadeout.cpp flip_level_transformer.cpp
