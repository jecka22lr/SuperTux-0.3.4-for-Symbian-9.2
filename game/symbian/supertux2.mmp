// SuperTux 0.3.4 (Milestone 2) for Symbian S60 3rd Edition - work in progress
TARGET        supertux2.exe
TARGETTYPE    exe
TARGETPATH    \sys\bin
UID           0x100039ce 0xA000A030

EPOCSTACKSIZE 81920
EPOCHEAPSIZE  4194304 50331648

ALWAYS_BUILD_AS_ARM

MACRO         HAVE_SDL
MACRO         OGG_USE_TREMOR_SEEK_BUG

// angle-bracket includes (<config.h>, <squirrel.h>, <tinygettext/...>, <boost/...>) need SYSTEMINCLUDE
SYSTEMINCLUDE . \epoc32\include \epoc32\include\stdapis \epoc32\include\stdapis\stlport
SYSTEMINCLUDE \epoc32\include\esdl \epoc32\include\physfs
SYSTEMINCLUDE ..\src ..\external\squirrel\include ..\external\tinygettext ..\external\findlocale
SYSTEMINCLUDE ..\external\obstack ..\external\binreloc
USERINCLUDE   . ..\src ..\external\squirrel\include ..\external\squirrel\squirrel ..\external\tinygettext\tinygettext

SOURCEPATH    ..\external\findlocale
SOURCE        findlocale.c

SOURCEPATH    ..\external\obstack
SOURCE        obstack.c

SOURCEPATH    ..\external\squirrel\sqstdlib
SOURCE        sqstdaux.cpp sqstdblob.cpp sqstdio.cpp sqstdmath.cpp sqstdrex.cpp sqstdstream.cpp
SOURCE        sqstdstring.cpp sqstdsystem.cpp

SOURCEPATH    ..\external\squirrel\squirrel
SOURCE        sqapi.cpp sqbaselib.cpp sqclass.cpp sqcompiler.cpp sqdebug.cpp sqfuncstate.cpp
SOURCE        sqlexer.cpp sqmem.cpp sqobject.cpp sqstate.cpp sqtable.cpp sqvm.cpp

SOURCEPATH    ..\external\tinygettext\tinygettext
SOURCE        dictionary.cpp dictionary_manager.cpp iconv.cpp language.cpp plural_forms.cpp po_parser.cpp
SOURCE        tinygettext.cpp unix_file_system.cpp

