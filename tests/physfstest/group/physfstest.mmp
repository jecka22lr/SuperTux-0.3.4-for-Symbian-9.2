TARGET        physfstest.exe
TARGETTYPE    exe
TARGETPATH    \sys\bin
UID           0x100039ce 0xA000A021

SYSTEMINCLUDE \epoc32\include \epoc32\include\stdapis \epoc32\include\esdl \epoc32\include\physfs
USERINCLUDE   ..\src
SOURCEPATH    ..\src
SOURCE        physfstest.cpp

EPOCSTACKSIZE 81920
EPOCHEAPSIZE  1048576 16777216

STATICLIBRARY sdlmain.lib sdl_mixer_ogg.lib tremor.lib physfs.lib
LIBRARY       sdl.lib sdlexe.lib libc.lib libm.lib libpthread.lib libz.lib
LIBRARY       euser.lib estlib.lib

SOURCEPATH    .
START RESOURCE physfstest.rss
HEADER
TARGETPATH    \resource\apps
LANG          SC
END

START RESOURCE physfstest_reg.rss
TARGETPATH    \private\10003a3f\apps
END

CAPABILITY    LocalServices
