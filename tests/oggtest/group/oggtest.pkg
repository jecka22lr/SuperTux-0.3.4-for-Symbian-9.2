;;; Ogg Vorbis test for SuperTux Milestone 2 (not for release)
;;; Borrows sdl.dll, sdlexe.dll and Open C from the installed SuperTux 0.1.3, so the two don't clash.
&EN
#{"OggTest"},(0xA000A020),0,1,0
%{"Jecka22LR"}
:"Jecka22LR"
[0x101F7961], 0, 0, 0, {"Series60ProductID"}

; needs SuperTux 0.1.3 Final Release 1.1 (it provides SDL and Open C)
(0xA000A003), 1, 1, 0, {"SuperTux"}

"\epoc32\release\gcce\urel\oggtest.exe"-"!:\sys\bin\oggtest.exe"
"\epoc32\data\z\resource\apps\oggtest.rsc"-"!:\resource\apps\oggtest.rsc"
"\epoc32\data\z\private\10003a3f\apps\oggtest_reg.rsc"-"!:\private\10003a3f\import\apps\oggtest_reg.rsc"

"..\data\test.ogg"-"!:\data\oggtest\test.ogg"
"..\data\test_sound.ogg"-"!:\data\oggtest\test_sound.ogg"
""-"c:\data\oggtest\log.txt",FILENULL
